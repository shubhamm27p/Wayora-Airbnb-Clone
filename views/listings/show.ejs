<% layout('layouts/boilerplate') %>
<script>
  window.mapToken = "<%= process.env.Map_Token || process.env.MAP_TOKEN || '' %>";
  window.listing = <%- JSON.stringify(listing) %>;
</script>

<div class="row mt-3 justify-content-center">
  <div class="col-8 col-md-6">
    <h3><%= listing.title %></h3>

    <div class="card show-card listing-card">
      <img src="<%= listing.image && listing.image.url ? listing.image.url : (listing.image) || 'https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=80' %>" class="card-img-top show-img" alt="<%= listing.title %>">
      <div class="card-body mt-2">
        <p class="card-text">Owned by <i><b><%= listing.owner ? listing.owner.username : "Unknown user" %></b></i></p>
        <% if (listing.category) { %>
          <p class="card-text"><span class="badge bg-secondary"><i class="fa-solid fa-tag"></i> <%= listing.category %></span></p>
        <% } %>
        <p class="card-text"><%= listing.description %></p>
        <p class="card-text"><span class="price">&#8377; <%= listing.price ? listing.price.toLocaleString('en-IN') : 0 %></span> / night</p>
        <p class="card-text"><%= listing.location %>, <%= listing.country %></p>
      </div>
    </div>

    <% if(currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
      <div class="btns mb-3">
        <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn col-3">Edit</a>
        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline ms-2">
          <button type="submit" class="btn btn-dark col-3">Delete</button>
        </form>
      </div>
    <% } %>

    <% if(currUser || listing.reviews.length > 0) { %>
      <hr />
    <% } %>

    <% if(currUser) { %>
      <h4>Leave a Review</h4>
      <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
        <div class="mb-3 mt-3">
          <label for="rating" class="form-label">Rating</label>
          <fieldset class="starability-slot">
            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
            <label for="first-rate1" title="Terrible">1 star</label>
            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
            <label for="first-rate2" title="Not good">2 stars</label>
            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
            <label for="first-rate3" title="Average">3 stars</label>
            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
            <label for="first-rate4" title="Very good">4 stars</label>
            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
            <label for="first-rate5" title="Amazing">5 stars</label>
          </fieldset>
        </div>  
          
        <div class="mb-3 mt-3">
          <label for="comment" class="form-label">Comments</label>
          <textarea id="comment" class="form-control" name="review[comment]" rows="5" required></textarea>
          <div class="invalid-feedback">Please enter a comment for a review.</div>
        </div>
        <button class="btn btn-outline-dark">Submit</button>
      </form>
      <% if(listing.reviews.length > 0) { %>
        <hr />
      <% } %>
    <% } %>

    <% if (listing.reviews.length > 0) { %>
      <div class="row">
        <p><b>All Reviews</b></p>
        <% for (let review of listing.reviews) { %>
          <div class="card col-5 mb-3 ms-3">
            <div class="card-body p-3">
              <h5 class="card-title">@<%= review.author ? review.author.username : "" %></h5>
              <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
              <p class="card-text"><%= review.comment %></p>   
            </div>
            <% if(currUser && review.author && currUser._id.equals(review.author._id)) { %>
              <form class="mb-3 ms-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                <button class="btn btn-sm btn-dark">Delete</button>   
              </form>
            <% } %>   
          </div>
        <% } %>
      </div>
    <% } %>

    <hr />
    <h3>Where you'll be</h3>
    <div id="map" class="mt-3 mb-4" style="height: 300px; width: 100%; border-radius: 10px;"></div>
  </div>
</div>

<script src="/js/map.js"></script>
