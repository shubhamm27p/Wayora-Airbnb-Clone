<% layout('layouts/boilerplate') %>
<div class="row">
  <div class="col-8">
    <h3><%= listing.title %></h3>
    <div class="card col-7 offset-3 show-card listing-card">
      <img src="<%= listing.image?.url || listing.image || 'https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?auto=format&fit=crop&w=1200&q=80' %>" class="card-img-top show-img" alt="<%= listing.title %>">
      <div class="card-body ">
        <p class="card-text">
          <strong><%= listing.title %></strong><br>
          <%= listing.description %><br>
          <span class="price">&#8377; <%= listing.price?.toLocaleString('en-IN') %></span><br>
          <%= listing.location %><br>
          <%= listing.country %>
        </p>
      </div>
    </div>
    <div class="btns mt-3">
      <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark">Edit</a>
      <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline ms-2">
        <input type="hidden" name="_method" value="DELETE">
        <button class="btn btn-danger">Delete</button>
      </form>
    </div>
  </div>
  <div class="col-8 offset-3 mb-3">
    <hr />
    <h4>Leave a Review</h4>
    <form action="/listings/<%= listing._id %>/reviews" method="POST" novalidate class="needs-validation">
      <div class="mb-3 mt-3">
        <label for="rating" class="form-label">Rating</label>
        <input type="range" class="form-range" min="1" max="5" id="rating" name="review[rating]" value="3" required>
        <div class="invalid-feedback">Please select a rating.</div>
      </div>
      <div class="mb-3 mt-3">
        <label for="comment" class="form-label">Comments</label>
        <textarea id="comment" class="form-control" name="review[comment]" rows="10" required></textarea>
        <div class="invalid-feedback">Please enter a comment for a review.</div>
      </div>
      <button class="btn btn-primary">Submit Review</button>
    </form>
    <hr />
   <p><b>All Reviews</b></p>
   <div class="row">
     <% for ( review of listing.reviews) { %>
       <div class="card col-5 mb-3 ms-3">
         <div class="card-body">
          <h5 class="card-title"> Jane Deo </h5>
           <p class="card-text"><%= review.comment %></p>
            <p class="card-text">Rating: <%= review.rating %> Stars</p>
         </div>
         <form class="mb-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
           <input type="hidden" name="_method" value="DELETE">
           <button class="btn btn-danger">Delete</button>
         </form>
       </div>
     <% } %>
   </div>
  </div>
</div>