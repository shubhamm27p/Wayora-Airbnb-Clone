<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>

</head>
<body>
    <nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings"><b>Home</b></a>
    </div>

    <div class="navbar-nav ms-auto">
      <form class="d-flex" action="/listings" method="GET" role="search">
        <input class="form-control me-2 search-inp" type="search" name="q" placeholder="Search Name, location, country..." value="<%= typeof q !== 'undefined' ? q : '' %>" aria-label="Search"/>
        <button class="btn search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
      </form>
    </div>


      <div class="navbar-nav ms-auto align-items-center">
        <% if(currUser){ %>
          <a class="nav-link btn btn-sm btn-danger text-white rounded-pill px-3 py-2 fw-bold" style="margin-right: 15px; box-shadow: 0 4px 10px rgba(226, 60, 71, 0.3); transition: all 0.3s ease;" href="/listings/new">
            <i class="fa-solid fa-plus me-1"></i> Add your Place
          </a>
        <% } %>
        <% if(!currUser){ %>
          <a class="nav-link fw-semibold" href="/signup">Signup</a>
          <a class="nav-link fw-semibold" href="/login">Login</a>
        <% } else { %>
          <a class="nav-link text-danger fw-bold" href="/logout">Logout</a>
        <% } %>
      </div>



    </div>
  </div>
</nav>
    
</body>
</html>