 <% if (success && success.length) { %>
<div class="alert alert-success alert-dismissible fade show col-6 offset-3" role="alert">
    <%= success %>
    <button type="button" class="btn-close" dara-bs-dismiss="alert" aria-label="close" ></button>
</div>
<% } %>


 <% if (error && error.length) { %>
<div class="alert alert-danger alert-dismissible fade show" role="danger">
    <%= error %>
</div>
<% } %>